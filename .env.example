# ============================================
# Transaction Service - Variáveis de Ambiente
# ============================================

# ============================================
# Banco de Dados PostgreSQL
# ============================================
# URL de conexão com o banco de dados PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/database
# Para Docker Compose: use localhost:5433 (porta externa)
# Para desenvolvimento local: use localhost:5432
DATABASE_URL=postgresql://transaction_service:transaction_service_pass@localhost:5433/transaction_service_db

# ============================================
# Configurações do Servidor
# ============================================
# Porta em que o serviço irá rodar
PORT=3002

# Ambiente de execução (development, production, test)
NODE_ENV=development

# ============================================
# Configurações de Segurança (JWT)
# ============================================
# IMPORTANTE: Altere este valor em produção!
# Chave secreta para assinatura e validação de tokens JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================
# Configurações de CORS
# ============================================
# Origens permitidas para requisições CORS
# Use '*' para desenvolvimento ou especifique origens separadas por vírgula
# Exemplo: http://localhost:3000,https://app.example.com
CORS_ORIGIN=*

# ============================================
# Comunicação com Outros Microsserviços
# ============================================
# URL do microsserviço de Clientes (User Service)
# Para Docker Compose: use http://user-service:3001
# Para desenvolvimento local: use http://localhost:3001
USER_SERVICE_URL=http://localhost:3001

# ============================================
# Configurações do RabbitMQ (Mensageria)
# ============================================
# URL de conexão com o RabbitMQ
# Formato: amqp://usuario:senha@host:porta/vhost
# Para Docker Compose: use amqp://admin:admin123@localhost:5672/
# Para desenvolvimento local: use amqp://admin:admin123@localhost:5672/
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/

# ============================================
# Configurações para Testes
# ============================================
# Para testes de integração, você pode usar:
# DATABASE_URL=postgresql://transaction_service:transaction_service_pass@localhost:5433/transaction_service_db
# JWT_SECRET=test-secret-key-for-integration-tests
